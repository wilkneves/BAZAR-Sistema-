# Copie para .env (NUNCA versionar). Em produção, injete pelo cofre (Azure Key Vault / Google Secret Manager).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Papel da API (sem DELETE) e papel dono (migrações)
DATABASE_URL=postgresql://bazar_api:troque@localhost:5432/bazar
MIGRATION_DATABASE_URL=postgresql://bazar_owner:troque@localhost:5432/bazar
# >= 32 caracteres aleatórios: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=bazar-luz-da-esperanca
JWT_AUDIENCE=bazar-web
ACCESS_TOKEN_TTL_SEC=900
SESSION_MAX_HOURS=12
# Origens permitidas (vírgula). Nunca "*".
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=true
TRUST_PROXY=false
UPLOAD_DIR=./uploads
LOG_LEVEL=info
# Usado só pelo seed na primeira instalação (troca obrigatória no 1º acesso)
ADMIN_LOGIN=admin
ADMIN_INITIAL_PASSWORD=
