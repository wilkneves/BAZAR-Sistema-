{
  "name": "bazar-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix apps/bazar-backend run dev",
    "dev:frontend": "npm --prefix apps/bazar-frontend run dev",
    "build:backend": "npm --prefix apps/bazar-backend run build",
    "build:frontend": "npm --prefix apps/bazar-frontend run build",
    "typecheck:backend": "npm --prefix apps/bazar-backend run typecheck",
    "typecheck:frontend": "npm --prefix apps/bazar-frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
